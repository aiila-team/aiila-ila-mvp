# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ila_db
POSTGRES_USER=ila_user
POSTGRES_PASSWORD=<secure_password>

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<secure_password>

# Redis
REDIS_URL=redis://redis:6379/0

# FastAPI
SECRET_KEY=<32-char-random-string>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# ML Models
HF_MODEL_CACHE=/models
SENTIMENT_MODEL=ai4bharat/indic-bert
SPACY_MODEL=en_core_web_sm

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# RSS Sources (live data)
RSS_FEEDS=https://feeds.feedburner.com/ndtvnews-india-news,https://timesofindia.indiatimes.com/rssfeedstopstories.cms

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
