{
  "_meta": {
    "version": "1.0.0",
    "description": "ILA Source Reliability Tier Configuration",
    "tiers": {
      "tier1": {"multiplier": 1.5, "label": "Government / Verified Agency"},
      "tier2": {"multiplier": 1.0, "label": "Mainstream News / Verified Social"},
      "tier3": {"multiplier": 0.7, "label": "Unverified Social / Anonymous"},
      "tier4": {"multiplier": 0.3, "label": "Dark Web / Suspected Disinfo"}
    }
  },

