# ============================================================================
# ENVIRONMENT CONFIGURATION
# ============================================================================

# PostgreSQL
DATABASE_URL=postgresql://ila_user:ila_password123@postgres:5432/ila_db

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ila_db
POSTGRES_USER=ila_user
POSTGRES_PASSWORD=ila_password123

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Redis
REDIS_URL=redis://redis:6379/0

# FastAPI
SECRET_KEY=my_super_secret_key_123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ML Models
HF_MODEL_CACHE=/models
SENTIMENT_MODEL=ai4bharat/indic-bert
SPACY_MODEL=en_core_web_sm

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# RSS Sources
RSS_FEEDS=https://feeds.feedburner.com/ndtvnews-india-news,https://timesofindia.indiatimes.com/rssfeedstopstories.cms

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws